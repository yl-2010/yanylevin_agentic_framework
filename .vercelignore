# Public pages stay. Email folders, Mac API, and agent trees do not.
# education/index.html and fitness/app.js are files, so education/*/ does not match them.

education/*/
fitness/*/

server/
ios/
macos/
.cursor/
oss/
docs/
deploy/
scripts/

data/chat-log.md
data/login-log.md
tmp/

# Gitignored. A root .vercelignore stops the CLI from reading .gitignore,
# so this prompt log was uploaded on every production deploy and served publicly.
data/usage/

# Local build junk. Vercel CLI does not honor nested gitignores, so the
# electives scraper venv/cache was riding along in every production deploy.
**/.venv/
**/venv/
**/__pycache__/
prasham-schedule-options/build/
Illustrator/

# South Asianesh Royale realtime server runs on the Mac (LaunchAgent com.yanylevin.sar-game), not Vercel.
southasianeshroyale-server/

# Large audio and slide files live in Vercel Blob (store yanylevin-media), not in each deploy.
# Each deploy used to carry ~255 MB of these, so a busy day of deploys blew the 10 GB
# Hobby Deployment Storage cap. vercel.json redirects each path to its Blob copy.
# New big media: `vercel blob put <path> --access public --pathname <path>`, then add it here and a redirect.
