<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Restore under a paid Apple Developer team (Personal Team cannot provision this):
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	Also: set AccountView.signInWithAppleEnabled = true and uncomment project.yml entitlements property.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.personalagent</string>
	</array>
</dict>
</plist>
