{
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/home/",
      "permanent": true
    },
    {
      "source": "/fitness",
      "destination": "/fitness/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    },
    {
      "source": "/debate",
      "destination": "/debate/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/home/class/:classId",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/project/:projectId",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/todo/:todoId/capsule/:capsuleId",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/todo/:todoId",
      "destination": "/home/index.html"
    },
    {
      "source": "/home/date/:dateId",
      "destination": "/home/index.html"
    },
    {
      "source": "/debate/class/:classId",
      "destination": "/debate/index.html"
    },
    {
      "source": "/debate/project/:projectId",
      "destination": "/debate/index.html"
    },
    {
      "source": "/debate/todo/:todoId/capsule/:capsuleId",
      "destination": "/debate/index.html"
    },
    {
      "source": "/debate/todo/:todoId",
      "destination": "/debate/index.html"
    },
    {
      "source": "/debate/date/:dateId",
      "destination": "/debate/index.html"
    },
    {
      "source": "/debate/case/:caseId/:side",
      "destination": "/debate/index.html"
    },
    {
      "source": "/api/home/:path*",
      "destination": "/api/home-api?p=:path*"
    },
    {
      "source": "/api/fitness/:path*",
      "destination": "/api/fitness-api?p=:path*"
    },
    {
      "source": "/api/dashboard/:path*",
      "destination": "/api/dashboard-api?p=:path*"
    },
    {
      "source": "/api/mac-user-token",
      "destination": "/api/mac-token?kind=user"
    }
  ],
  "headers": [
    {
      "source": "/runtime-config.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
