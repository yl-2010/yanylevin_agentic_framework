<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yanylevin.cursor-usage</string>
  <key>WorkingDirectory</key>
  <string>$HOME/yanylevin_agentic_framework</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--experimental-sqlite</string>
    <string>--env-file=$HOME/yanylevin_agentic_framework/server/.env</string>
    <string>$HOME/yanylevin_agentic_framework/server/cursor-usage-collect.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/yanylevin-cursor-usage.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/yanylevin-cursor-usage.log</string>
</dict>
</plist>
