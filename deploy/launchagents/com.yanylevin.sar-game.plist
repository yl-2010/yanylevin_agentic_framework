<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yanylevin.sar-game</string>
  <key>WorkingDirectory</key>
  <string>$HOME/yanylevin_agentic_framework/southasianeshroyale-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>$HOME/yanylevin_agentic_framework/southasianeshroyale-server/server.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SAR_PORT</key>
    <string>3021</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/personal-agent/personal-agent-sar-game.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/personal-agent/personal-agent-sar-game.log</string>
</dict>
</plist>
