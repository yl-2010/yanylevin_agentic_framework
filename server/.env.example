OWNER_EMAIL=you@example.com
OWNER_EMAIL_ALIASES=you@icloud.com

# LM Studio: Developer tab → Start server (default port 1234)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Exact id from GET http://127.0.0.1:1234/v1/models in LM Studio
LM_STUDIO_MODEL=openai/gpt-oss-20b

PORT=3004
HOST=0.0.0.0

# Required for /api/chat (browser will get a JWT from a future Vercel /api/mac-token).
# When Auth.js is added, set this to the exact same string as NEXTAUTH_SECRET on Vercel.
AUTH_SECRET=

# JWT claims (must match whatever mints the Bearer token)
JWT_ISSUER=personalagent-next
JWT_AUDIENCE=personalagent-mac-api

# Cursor SDK local agents (never commit the real key).
# ModelSelection id only — never compound ids like composer-2.5-fast or grok-4.6-high.
# CURSOR_API_KEY=
# Express reloads this key and recreates the Cursor agent on auth blips
# ("log out and back in") without a process restart. Grok high-load is not
# auth: app/web agents try Grok twice then Auto twice, then show the usual
# error so you can resend. The Working bubble switches to reconnecting copy.
# Nightly Grok jobs try Grok eight times, then Auto twice; if Auto is still
# overloaded they wait 5 min three times, then back off to 10 / 20 / 40 / 60 min.
# Scheduled jobs also retry later the same day if the in-process waits fail.
# Personal Agent text-only: grok-4.6 high. To go back to Composer Fast when usage
# is tight, set this to composer-2.5 (personal-agent.js switches params automatically).
# CURSOR_PERSONAL_MODEL=grok-4.6
# Personal Agent attachments: grok-4.6 high. Keep this grok if text-only goes Composer.
# CURSOR_PERSONAL_ATTACHMENT_MODEL=grok-4.6
# Fitness agent: Composer 2.5 Fast. Independent of CURSOR_PERSONAL_MODEL.
# CURSOR_FITNESS_MODEL=composer-2.5
# Daily briefing (06:00 compile, 07:00 due): 3-phase pipeline in daily-briefing-agent.js
#   news grok-4.6 xhigh, agent-recap grok-4.6 high, unslop composer-2.5
# CURSOR_AGENT_RECAP_MODEL=grok-4.6
# CURSOR_BRIEFING_UNSLOP_MODEL=composer-2.5
# Nightly agents share nightlyAgentsLocalTime in daily-briefing/meta.json (01:00):
# Location history compose (every 4h if new points, plus 01:00 local): Composer 2.5
# with Fast off (params in location-history-agent.js). Never composer-2.5-fast.
# CURSOR_LOCATION_HISTORY_MODEL=composer-2.5
# Location enrichment (01:00, after compose): grok-4.6 high, Fast off.
# CURSOR_LOCATION_ENRICHMENT_MODEL=grok-4.6
# Canvas nightly sync (01:00 local): grok-4.6 high, Fast off (params in canvas-sync.js).
# CURSOR_CANVAS_SYNC_MODEL=grok-4.6
# EPS Outlook history fill (Composer 2.5, Fast off). Not scheduled.
# CURSOR_SCHOOL_MAIL_FILL_MODEL=composer-2.5
# Context synthesis (02:30, after nightly agents): grok-4.6 xhigh, Fast off.
# CURSOR_CONTEXT_SYNTHESIS_MODEL=grok-4.6
# Nightly fact-check (03:30, after location-brain and health-brain): grok-4.6 xhigh.
# CURSOR_FACT_CHECK_MODEL=grok-4.6

# Optional CORS allowlist (comma-separated)
# ALLOWED_ORIGINS=https://yanylevin.com,https://www.yanylevin.com,http://localhost:8080

# Optional: iPhone Shortcut POST /api/education/location without a session JWT.
# openssl rand -hex 32 — never commit the real value.
# LOCATION_INGEST_TOKEN=

# Optional: iPhone Shortcut POST /api/education/health (Apple Health dump).
# openssl rand -hex 32 — never commit the real value. Falls back to
# LOCATION_INGEST_TOKEN if this is unset.
# HEALTH_INGEST_TOKEN=
# Nightly takeaways (01:00): Composer 2.5 with Fast off.
# CURSOR_HEALTH_TAKEAWAYS_MODEL=composer-2.5

# Canvas LMS nightly sync (optional). Student token from your school's Canvas.
# CANVAS_BASE_URL=https://canvas.instructure.com
# CANVAS_ACCESS_TOKEN=
